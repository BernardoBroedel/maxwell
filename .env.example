# Copie para .env e preencha. O .env nunca vai para o git.

# --- LLM usado pelo tutor (qualquer API compatível com OpenAI) ---
# Groq (gratuito): chave em console.groq.com → API Keys (começa com gsk_). Veja docs/TUTORIAL_LLM.md
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Qwen local (Ollama nativo no Windows):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:4b

# --- Open WebUI ---
WEBUI_PORT=3000
# Gere com: openssl rand -hex 32
WEBUI_SECRET_KEY=
# Credenciais do admin: criam o admin numa instalação nova e são usadas pelo
# script de configuração (docker compose --profile setup run --rm configurar)
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
# Para onde o Open WebUI envia as conversas (padrão: o tutor Maxwell)
WEBUI_OPENAI_BASE_URL=http://backend:8000/v1
WEBUI_OPENAI_API_KEY=nao-usada
